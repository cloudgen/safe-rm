# =============================================================================
# srm_* — remove guard (domain prefix)
# =============================================================================
#
# GENERAL PURPOSE:
# Decide whether a path may be removed, say so through out_*, and call the
# system rm only when every path is allowed and --dry-run is off.
#
# Product law: requirement-domain-safe-rm.md
# Output law: requirement-shell-output-requirements.md (product text via out_*)
#
# Class B printf in this section returns a path or a JSON fragment to the
# caller. It is not a user-facing message. User-facing lines use out_*.
#
# =============================================================================
# CIAO-Lite Protection Zone
# Do NOT simplify, refactor, or remove without explicit user instruction
# This section exists for safety and anti-fragility reasons
# --dry-run must never call the system rm
# A refused path must stop the whole command before any removal
# =============================================================================

srm_cleanup_work() {
    _w=${SRM_WORK-}
    [ -n "$_w" ] || return 0
    case "$_w" in
        *..*)
            SRM_WORK=
            return 0
            ;;
    esac
    if [ -n "${HOME-}" ] && [ "$_w" = "$HOME" ]; then
        SRM_WORK=
        return 0
    fi
    case "$_w" in
        /|/home|/usr|/usr/bin|/bin|/etc|/var|/root)
            SRM_WORK=
            return 0
            ;;
    esac
    _ok=0
    case "$_w" in
        /tmp/safe-rm-work.*|/var/tmp/safe-rm-work.*|/dev/shm/safe-rm-work.*)
            _ok=1
            ;;
        *)
            if [ -n "${TMPDIR-}" ]; then
                case "$_w" in
                    "${TMPDIR%/}/safe-rm-work."*)
                        _ok=1
                        ;;
                esac
            fi
            ;;
    esac
    if [ "$_ok" -eq 1 ]; then
        if [ -x /bin/rm ]; then
            /bin/rm -rf -- "$_w" 2>/dev/null || true
        elif [ -x /usr/bin/rm ]; then
            /usr/bin/rm -rf -- "$_w" 2>/dev/null || true
        fi
    fi
    SRM_WORK=
}

# Return a lexical absolute path on stdout (class B).
srm_lexical_abs() {
    _in=${1-}
    (
        case "$_in" in
            /*) _path=$_in ;;
            *) _path="${PWD%/}/${_in}" ;;
        esac
        _out=""
        _oldifs=$IFS
        IFS=/
        set -f
        # shellcheck disable=SC2086
        set -- $_path
        set +f
        IFS=$_oldifs
        for _seg in "$@"; do
            case "$_seg" in
                ''|.)
                    ;;
                ..)
                    case "$_out" in
                        ''|/) _out="" ;;
                        *) _out=${_out%/*} ;;
                    esac
                    ;;
                *)
                    _out="${_out}/${_seg}"
                    ;;
            esac
        done
        [ -n "$_out" ] || _out=/
        printf '%s\n' "$_out"
    )
}

# Physical directory on stdout (class B).
srm_phys_dir() {
    _d=${1-}
    (CDPATH= cd -P -- "$_d" 2>/dev/null && pwd)
}

# Absolute path on stdout (class B). Missing paths stay lexical.
srm_resolve_path() {
    _raw=${1-}
    [ -n "$_raw" ] || return 1
    if [ -d "$_raw" ]; then
        srm_phys_dir "$_raw"
        return $?
    fi
    if [ -e "$_raw" ] || [ -L "$_raw" ]; then
        _dir=$(dirname -- "$_raw")
        _base=$(basename -- "$_raw")
        _absdir=$(srm_phys_dir "$_dir") || return 1
        _full="${_absdir%/}/${_base}"
        _guard=0
        while [ -L "$_full" ] && [ "$_guard" -lt 16 ]; do
            _tgt=$(readlink -- "$_full" 2>/dev/null) || break
            case "$_tgt" in
                /*) _next=$_tgt ;;
                *) _next=$(srm_lexical_abs "${_full%/*}/${_tgt}") || break ;;
            esac
            if [ -d "$_next" ] && [ ! -L "$_next" ]; then
                _full=$(srm_phys_dir "$_next") || _full=$_next
                break
            fi
            _full=$_next
            _guard=$((_guard + 1))
        done
        if [ -d "$_full" ]; then
            _full=$(srm_phys_dir "$_full") || return 1
        fi
        printf '%s\n' "$_full"
        return 0
    fi
    srm_lexical_abs "$_raw"
}

# Return the refuse sentence on stdout (class B). Caller prints it with out_*.
srm_msg_refuse() {
    _path=${1-}
    _class=${2-}
    case "$_class" in
        DENY-USR-BIN)
            printf '%s\n' "Refusing to remove ${_path}. That path is /usr/bin or something inside it. Removing it breaks programs on this machine. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
        DENY-LOGIN-HOME)
            printf '%s\n' "Refusing to remove ${_path}. That path is the login home or is inside the login home. Removing it destroys files and projects. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} rm --dry-run on a folder outside the login home, such as a temporary directory, or stop."
            ;;
        DENY-HOME-USER)
            printf '%s\n' "Refusing to remove ${_path}. That path is /home or a folder inside /home. Removing it destroys a login's files. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} rm --dry-run on a folder outside /home, or stop."
            ;;
        DENY-HOME-ANCESTOR)
            printf '%s\n' "Refusing to remove ${_path}. That path contains the login home. Removing it destroys files and projects. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
        DENY-ROOT|DENY-HOST)
            printf '%s\n' "Refusing to remove ${_path}. That path is a system directory. Removing it can make the machine unusable. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
        DENY-EMPTY)
            printf '%s\n' "Refusing to remove an empty path. Name a real folder. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>."
            ;;
        DENY-STDIN)
            printf '%s\n' "Refusing to remove standard input. This program only checks filesystem paths. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>."
            ;;
        *)
            printf '%s\n' "Refusing to remove ${_path}. The path could not be checked safely. Nothing was removed. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
    esac
}

srm_msg_allow() {
    _path=${1-}
    _exists=${2-}
    _kind=${3-}
    _dry=${4-}
    if [ "$_dry" = true ]; then
        if [ "$_exists" = true ]; then
            printf '%s\n' "Dry-run: ${_path} exists (${_kind}). Removal is allowed. Nothing was removed."
        else
            printf '%s\n' "Dry-run: ${_path} does not exist. Removal would be allowed if it existed. Nothing was removed."
        fi
    else
        if [ "$_exists" = true ]; then
            printf '%s\n' "${_path} exists (${_kind}). Removal is allowed."
        else
            printf '%s\n' "${_path} does not exist. Removal would be allowed if it existed."
        fi
    fi
}

# Sets SRM_RAW SRM_RESOLVED SRM_EXISTS SRM_KIND SRM_CLASS SRM_VERDICT SRM_MESSAGE.
srm_classify() {
    SRM_RAW=${1-}
    SRM_RESOLVED=
    SRM_EXISTS=false
    SRM_KIND=missing
    SRM_CLASS=ALLOW
    SRM_VERDICT=allow
    SRM_MESSAGE=

    case "$SRM_RAW" in
        '')
            SRM_CLASS=DENY-EMPTY
            SRM_VERDICT=refuse
            SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
            return 0
            ;;
        -)
            SRM_CLASS=DENY-STDIN
            SRM_VERDICT=refuse
            SRM_RESOLVED=-
            SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
            return 0
            ;;
        '$HOME'|'$HOME'/*|'${HOME}'|'${HOME}'/*|'~'|'~'/*)
            SRM_CLASS=DENY-LOGIN-HOME
            SRM_VERDICT=refuse
            SRM_RESOLVED=$SRM_RAW
            SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
            return 0
            ;;
    esac

    SRM_RESOLVED=$(srm_resolve_path "$SRM_RAW") || {
        SRM_CLASS=DENY-UNRESOLVED
        SRM_VERDICT=refuse
        SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
        return 0
    }

    if [ -d "$SRM_RESOLVED" ]; then
        SRM_KIND=dir
        SRM_EXISTS=true
    elif [ -L "$SRM_RESOLVED" ]; then
        SRM_KIND=link
        SRM_EXISTS=true
    elif [ -f "$SRM_RESOLVED" ]; then
        SRM_KIND=file
        SRM_EXISTS=true
    elif [ -e "$SRM_RESOLVED" ]; then
        SRM_KIND=other
        SRM_EXISTS=true
    else
        SRM_KIND=missing
        SRM_EXISTS=false
    fi

    _home=$(srm_resolve_path "${HOME}") || _home=$(srm_lexical_abs "${HOME}")

    case "$SRM_RESOLVED" in
        /)
            SRM_CLASS=DENY-ROOT
            ;;
        /usr/bin|/usr/bin/*)
            SRM_CLASS=DENY-USR-BIN
            ;;
        /home|/home/*)
            SRM_CLASS=DENY-HOME-USER
            ;;
        /usr|/bin|/sbin|/etc|/var|/boot|/root|/lib|/lib64|/opt|/dev|/proc|/sys)
            SRM_CLASS=DENY-HOST
            ;;
        *)
            SRM_CLASS=ALLOW
            ;;
    esac

    if [ "$SRM_RESOLVED" = "$_home" ]; then
        SRM_CLASS=DENY-LOGIN-HOME
    fi
    case "$SRM_RESOLVED" in
        "$_home"/*)
            SRM_CLASS=DENY-LOGIN-HOME
            ;;
    esac
    case "$_home" in
        "$SRM_RESOLVED"/*)
            SRM_CLASS=DENY-HOME-ANCESTOR
            ;;
    esac

    if [ "$SRM_CLASS" = ALLOW ]; then
        SRM_VERDICT=allow
        if [ "${DRY_RUN:-0}" -eq 1 ]; then
            SRM_MESSAGE=$(srm_msg_allow "$SRM_RAW" "$SRM_EXISTS" "$SRM_KIND" true)
        else
            SRM_MESSAGE=$(srm_msg_allow "$SRM_RAW" "$SRM_EXISTS" "$SRM_KIND" false)
        fi
    else
        SRM_VERDICT=refuse
        SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
    fi
}

# One JSON object on stdout (class B). Inserted via out_json @results.
srm_json_item() {
    printf '{'
    printf '"path":"%s"' "$(util_json_escape "${1-}")"
    printf ',"resolved":"%s"' "$(util_json_escape "${2-}")"
    printf ',"exists":"%s"' "$(util_json_escape "${3-}")"
    printf ',"kind":"%s"' "$(util_json_escape "${4-}")"
    printf ',"verdict":"%s"' "$(util_json_escape "${5-}")"
    printf ',"class":"%s"' "$(util_json_escape "${6-}")"
    printf ',"message":"%s"' "$(util_json_escape "${7-}")"
    printf '}'
}

srm_flag_ok() {
    _f=${1-}
    case "$_f" in
        --recursive|--force|--dir|--verbose|--one-file-system|--interactive=never|--interactive=once|--interactive=always|--interactive)
            return 0
            ;;
        --*)
            return 1
            ;;
        -)
            return 1
            ;;
        -*)
            _rest=${_f#-}
            [ -n "$_rest" ] || return 1
            while [ -n "$_rest" ]; do
                _c=${_rest%"${_rest#?}"}
                case "$_c" in
                    r|R|f|v|i|d|I) ;;
                    *) return 1 ;;
                esac
                _rest=${_rest#?}
            done
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

srm_flags_need_prompt() {
    [ -f "${SRM_WORK}/flags" ] || return 1
    while IFS= read -r _f; do
        case "$_f" in
            --interactive=never)
                ;;
            --interactive|--interactive=always|--interactive=once)
                return 0
                ;;
            -*)
                _rest=${_f#-}
                case "$_rest" in
                    *i*) return 0 ;;
                esac
                ;;
        esac
    done < "${SRM_WORK}/flags"
    return 1
}

# System rm that is not this program. Path on stdout (class B).
srm_origin_rm() {
    _self=$0
    for _c in /bin/rm /usr/bin/rm; do
        [ -x "$_c" ] || continue
        if [ "$_c" = "$_self" ]; then
            continue
        fi
        if [ -L "$_c" ]; then
            _t=$(readlink -- "$_c" 2>/dev/null || true)
            case "$_t" in
                *safe-rm*) continue ;;
            esac
        fi
        printf '%s\n' "$_c"
        return 0
    done
    return 1
}

# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# --dry-run must return before any system rm.
srm_exec_one() {
    _origin=${1-}
    _path=${2-}
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        out_die "Dry-run tried to remove ${_path}. Nothing was removed. STOP. Next: ${APP_NAME} rm --dry-run <path>"
    fi
    set -- "$_origin"
    if [ -f "${SRM_WORK}/flags" ]; then
        while IFS= read -r _flag; do
            [ -n "$_flag" ] || continue
            set -- "$@" "$_flag"
        done < "${SRM_WORK}/flags"
    fi
    set -- "$@" "--" "$_path"
    "$@"
}

srm_emit_json() {
    _summary=${1-}
    _dry=${2-}
    _removed=${3-}
    _ok=${4-}
    _items=${5-}
    if [ "${JSON:-0}" -eq 1 ]; then
        out_json "rm" "$_summary" \
            "dry_run" "$_dry" \
            "removed" "$_removed" \
            "ok" "$_ok" \
            "@results" "[${_items}]"
    fi
}

srm_cmd_rm() {
    : "${DRY_RUN:=0}"
    : "${JSON:=0}"
    : "${APP_NAME:=safe-rm}"

    SRM_WORK=$(mktemp -d "${TMPDIR:-/tmp}/safe-rm-work.XXXXXX") || {
        out_die "Could not create a scratch directory for the remove check. Nothing was removed. Next: check that the temp directory is writable."
    }
    trap 'srm_cleanup_work' EXIT INT HUP TERM
    : > "${SRM_WORK}/flags"

    _n=0
    _end=0
    while [ $# -gt 0 ]; do
        _arg=$1
        shift
        if [ "$_end" -eq 0 ]; then
            case "$_arg" in
                --dry-run)
                    DRY_RUN=1
                    continue
                    ;;
                --)
                    _end=1
                    continue
                    ;;
                --quiet|-q)
                    QUIET=1
                    continue
                    ;;
                --json)
                    JSON=1
                    QUIET=1
                    continue
                    ;;
                --debug)
                    DEBUG=1
                    continue
                    ;;
                -*)
                    if srm_flag_ok "$_arg"; then
                        printf '%s\n' "$_arg" >> "${SRM_WORK}/flags"
                        continue
                    fi
                    out_die "Unknown remove option: ${_arg}. Nothing was removed. Next: ${APP_NAME} help"
                    ;;
            esac
        fi
        _n=$((_n + 1))
        printf '%s\n' "$_arg" > "${SRM_WORK}/path.${_n}"
    done

    if [ "$_n" -eq 0 ]; then
        out_die "No path was given. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>"
    fi

    if [ "$DRY_RUN" -eq 0 ] && [ "${TTY:-0}" -eq 0 ]; then
        if srm_flags_need_prompt; then
            out_die "This remove asked for a prompt, and there is no terminal, so it would wait forever. Nothing was removed. Next: drop -i, or use ${APP_NAME} rm --dry-run <path>."
        fi
    fi

    _i=1
    _refused=0
    _items=
    while [ "$_i" -le "$_n" ]; do
        IFS= read -r _path < "${SRM_WORK}/path.${_i}" || _path=
        srm_classify "$_path"
        if [ "$SRM_VERDICT" = refuse ]; then
            _refused=1
            out_error "$SRM_MESSAGE"
        elif [ "$DRY_RUN" -eq 1 ]; then
            out_info "$SRM_MESSAGE"
        fi
        _item=$(srm_json_item "$SRM_RAW" "$SRM_RESOLVED" "$SRM_EXISTS" "$SRM_KIND" "$SRM_VERDICT" "$SRM_CLASS" "$SRM_MESSAGE")
        if [ -z "$_items" ]; then
            _items=$_item
        else
            _items="${_items},${_item}"
        fi
        _i=$((_i + 1))
    done

    if [ "$_refused" -eq 1 ]; then
        _stop="Stopped. One or more paths were refused. Nothing was removed. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} help"
        if [ "$DRY_RUN" -eq 1 ]; then
            srm_emit_json "$_stop" true false false "$_items"
        else
            srm_emit_json "$_stop" false false false "$_items"
        fi
        out_die "$_stop"
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        _done="Dry-run finished. Every listed path may be removed. Nothing was removed."
        srm_emit_json "$_done" true false true "$_items"
        out_success "$_done"
        return 0
    fi

    _origin=$(srm_origin_rm) || {
        out_die "Could not find the system rm outside this program. Nothing was removed. Next: use the rm that came with the system, or stop."
    }
    _i=1
    while [ "$_i" -le "$_n" ]; do
        IFS= read -r _path < "${SRM_WORK}/path.${_i}" || _path=
        if srm_exec_one "$_origin" "$_path"; then
            out_success "Removed ${_path}."
        else
            out_error "The system rm failed for ${_path}. Later paths were not removed."
            srm_emit_json "The system rm failed for ${_path}. Later paths were not removed." false false false "$_items"
            return 1
        fi
        _i=$((_i + 1))
    done
    _done="Removed every listed path."
    srm_emit_json "$_done" false true true "$_items"
    return 0
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Thin dispatcher for the safe-rm CLI (Type 0 plus the rm guard).
# Handles:
#   - Auto-install behavior for classic `curl | sh` one-liner (zero arguments)
#   - Global flag parsing (--quiet, --json, --debug, --force)
#   - Command routing for all Type 0 self-management commands
#
# This is the single entry point when the script is executed directly.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Never call undefined functions. Always use inst_is_installed.
#   Auto-install block is kept at the very top as required by existing comments.
# - Intentional (Principle 2): All supported commands from
#   requirement-shell-cli-interface.md and app_help() are recognized and routed.
# - Anti-fragile (Principle 3): Works correctly in interactive TTY, quiet, JSON,
#   and non-interactive `curl | sh` environments.
# - Over-protect (Principle 18): Explicit if/then logic, safe defaults, and centralized
#   output via out_die for unknown commands.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central command dispatcher. Changes here affect every execution path.
#
# Lessons Learned (CIAO Reflection):
# 2026-06-26:
#   - Original version called non-existent functions and only recognized
#     version/about/help; expanded routing and safe defaults.
# 2026-07-12:
#   - Wired --force → FORCE=1 and FORCE_REINSTALL=1 (requirement-shell-cli-interface).
# 2026-07-14:
#   - version routes through app_version (no dual inline path).
#   - zero-arg install propagates failure exit status.
#   - Type O empty argv: always install-ensure (not help when already installed).
#     Cases A/B/C (not installed / local / global). --force only for deliberate
#     re-download/replace — not required for a second one-liner run.
#     SSOT: requirement-shell-cli-zero-arguments.md (safe-rm = Type O).
# 2026-08-11:
#   - Specializee injection anchors (DOMAIN_DISPATCH_*) for A→B products; empty
#     argv remains Type O — domain setup uses explicit verbs only.
#
# Last reviewed: 2026-08-11
# =============================================================================

app_main() {
    # --- Safe Variable Defaults ---
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${DRY_RUN:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"

    # Effective scratch/cache root for this run (requirement-shell-cli-storage).
    # Priority: /dev/shm → /tmp → STORAGE_DIR (persistent cache fallback).
    # Resolver creates root fail-closed. Export TMPDIR so mktemp -t (install
    # download stage) lands under the isolated product root.
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # === ZERO-ARG = Type O CLI self-install-ensure (curl | sh contract) ===
    # Product type: Type O (online-install) — not Type N help-default.
    # Empty argv always means "ensure installed", never help, never domain setup.
    # Cases: not installed | installed local | installed global
    # - not installed → self-install (TTY prompt via inst_maybe_install; non-TTY auto)
    # - already installed → success no-op (inst_self_install); no --force required
    # - script $0 copies; interpreter $0 downloads
    # - --force / FORCE_REINSTALL only for deliberate replace
    # Exit status must reflect install outcome (failed copy/download/checksum → non-zero).
    # SSOT: docs/requirements/requirement-shell-cli-zero-arguments.md
    #       docs/requirements/requirement-shell-cli-self-install.md
    # Specializee: do NOT replace this block with domain full-setup.
    if [ $# -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_self_install
            exit $?
        elif inst_is_installed; then
            inst_self_install
            exit $?
        else
            inst_maybe_install
            exit $?
        fi
    fi

    # === Argument parsing: flags and commands (order-independent) ===
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            # --- DOMAIN_DISPATCH_FLAGS (specializee injection) ---
            --dry-run)
                DRY_RUN=1
                ;;
            # --- end DOMAIN_DISPATCH_FLAGS ---
            version|about|help|version-check|self-update|self-uninstall|self-install|install)
                COMMAND="$1"
                ;;
            # --- DOMAIN_DISPATCH_COMMANDS (specializee injection) ---
            rm)
                COMMAND="rm"
                shift
                break
                ;;
            # --- end DOMAIN_DISPATCH_COMMANDS ---
            *)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE}"

    case "${COMMAND}" in
        version)
            app_version
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        self-install|install)
            inst_self_install
            ;;
        # --- DOMAIN_DISPATCH_ROUTES (specializee injection) ---
        rm)
            srm_cmd_rm "$@"
            ;;
        # --- end DOMAIN_DISPATCH_ROUTES ---
        help|*)
            app_help
            ;;
    esac
}


