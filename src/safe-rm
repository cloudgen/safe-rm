}

# =============================================================================
# app_default() - TTY numbered menu / off-TTY help
# =============================================================================
#
# GENERAL PURPOSE:
# menu / main / interactive empty argv. On a terminal: ignore --json and
# --quiet while painting, show the front board, open 1 or 8, or run a typed
# leaf. After a leaf, show the front board again. A bad pick reprints this
# layer (does not exit). Off a terminal: help.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-zero-arguments.md
#
# Last updated: 2026-09-27
# =============================================================================
app_default() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=safe-rm}"

    if [ "${TTY}" -ne 1 ]; then
        app_help
        return 0
    fi

    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET

    while true; do
        app_default_print_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            unset _pick _menu_json _menu_quiet
            return 0
        fi
        case "${_pick}" in
            9|exit|quit|Exit|QUIT|"")
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                unset _pick _menu_json _menu_quiet
                return 0
                ;;
            1|remove-guard)
                if app_default_rm_loop; then
                    JSON=0
                    QUIET=0
                    export JSON QUIET
                    unset _pick
                    continue
                fi
                ;;
            8|self-management)
                if app_default_self_loop; then
                    JSON=0
                    QUIET=0
                    export JSON QUIET
                    unset _pick
                    continue
                fi
                ;;
            11|rm)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                app_default_ask_rm
                _rc=$?
                JSON=0
                QUIET=0
                export JSON QUIET
                unset _pick
                if [ "${_rc}" -eq 1 ]; then
                    JSON="${_menu_json}"
                    QUIET="${_menu_quiet}"
                    export JSON QUIET
                    unset _rc _menu_json _menu_quiet
                    return 0
                fi
                unset _rc
                continue
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_default_run_self_leaf "${_pick}"; then
            JSON=0
            QUIET=0
            export JSON QUIET
            unset _pick
            continue
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        out_error "Not a menu choice '${_pick}'. Type 1, 8, 9 to leave, or a listed command name."
    done
}

# =============================================================================
# app_token_command() - Verb or its --switch, as the canonical command
# =============================================================================
#
# help and --help are the same command. version and --version. self-install
# and --self-install. The same pair for every live verb. -restore is the
# 2023 token for restore. Prints the command name. Returns 1 when $1 is not
# one of those words.
#
# PRINTF EXCEPTION (class B – function return-via-stdout): command name.
#
# Last updated: 2026-09-27
# =============================================================================
app_token_command() {
    case "${1-}" in
        help|--help) printf '%s\n' help ;;
        version|--version) printf '%s\n' version ;;
        about|--about) printf '%s\n' about ;;
        version-check|--version-check) printf '%s\n' version-check ;;
        self-update|--self-update) printf '%s\n' self-update ;;
        self-uninstall|--self-uninstall) printf '%s\n' self-uninstall ;;
        self-install|--self-install) printf '%s\n' self-install ;;
        install|--install) printf '%s\n' install ;;
        menu|--menu) printf '%s\n' menu ;;
        main|--main) printf '%s\n' main ;;
        setup|--setup) printf '%s\n' setup ;;
        restore|--restore|-restore) printf '%s\n' restore ;;
        rm|--rm) printf '%s\n' rm ;;
        *) return 1 ;;
    esac
}

# =============================================================================
# app_run_command() - Run one canonical command
# =============================================================================
#
# $1 is the name from app_token_command. Remaining args belong to rm.
#
# Last updated: 2026-09-27
# =============================================================================
app_run_command() {
    _run=${1-}
    shift
    case "${_run}" in
        version)
            app_version
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        self-install|install)
            inst_self_install
            ;;
        menu|main)
            app_default
            ;;
        setup)
            srm_cmd_setup
            ;;
        restore)
            srm_cmd_restore
            ;;
        # --- DOMAIN_DISPATCH_ROUTES (specializee injection) ---
        rm)
            srm_cmd_rm "$@"
            ;;
        # --- end DOMAIN_DISPATCH_ROUTES ---
        help|*)
            app_help
            ;;
    esac
    _rc=$?
    unset _run
    return $_rc
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Thin dispatcher for the safe-rm CLI (Type 0 plus the rm guard).
# Handles:
#   - Auto-install behavior for classic `curl | sh` one-liner (zero arguments)
#   - Global flag parsing (--quiet, --json, --debug, --force)
#   - Command routing for all Type 0 self-management commands
#
# This is the single entry point when the script is executed directly.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Never call undefined functions. Always use inst_is_installed.
#   Auto-install block is kept at the very top as required by existing comments.
# - Intentional (Principle 2): All supported commands from
#   requirement-shell-cli-interface.md and app_help() are recognized and routed.
# - Anti-fragile (Principle 3): Works correctly in interactive TTY, quiet, JSON,
#   and non-interactive `curl | sh` environments.
# - Over-protect (Principle 18): Explicit if/then logic, safe defaults, and centralized
#   output via out_die for unknown commands.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central command dispatcher. Changes here affect every execution path.
#
# Lessons Learned (CIAO Reflection):
# 2026-06-26:
#   - Original version called non-existent functions and only recognized
#     version/about/help; expanded routing and safe defaults.
# 2026-07-12:
#   - Wired --force → FORCE=1 and FORCE_REINSTALL=1 (requirement-shell-cli-interface).
# 2026-07-14:
#   - version routes through app_version (no dual inline path).
#   - zero-arg install propagates failure exit status.
#   - Type O empty argv: always install-ensure (not help when already installed).
#     Cases A/B/C (not installed / local / global). --force only for deliberate
#     re-download/replace — not required for a second one-liner run.
#     SSOT: requirement-shell-cli-zero-arguments.md (safe-rm = Type O).
# 2026-08-11:
#   - Specializee injection anchors (DOMAIN_DISPATCH_*) for A→B products; empty
#     argv remains Type O — domain setup uses explicit verbs only.
# 2026-09-27:
#   - Interactive empty argv (TTY, not quiet/json) opens the numbered menu.
#     Non-interactive / quiet / json empty argv stays CLI self-install.
#     menu and main are the named menu verbs. rm lives under front category 1.
#   - Each live verb is also its switch: help and --help, version and
#     --version, self-install and --self-install, and the same pair for the
#     rest. On safe-rm the bare word and the switch are that command.
#     On the command named rm only the --switch is that command. A bare
#     word is a path, so rm version removes a link named version.
#     origin-rm --help and origin-rm --version are the remover's own text.
#
# Last reviewed: 2026-09-27
# =============================================================================

app_main() {
    # --- Safe Variable Defaults ---
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${DRY_RUN:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"

    # Cache folder + persistence (requirement-shell-cli-storage).
    # Linux: shm leaf, then /tmp leaf, then ${HOME}/.cache leaf.
    # A missed tier is silent. Export TMPDIR so mktemp lands in the cache leaf.
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    STORAGE_DIR=$(util_fallback_cache_dir)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Command name rm: the remover's argument list. A --switch is a
    # lifecycle command. A bare word is a path (rm version removes a link
    # named version). requirement-domain-safe-rm.md §2.1.1
    if srm_invoked_as_rm; then
        srm_cmd_rm "$@"
        exit $?
    fi

    # === ZERO-ARG split ===
    # Interactive 0-argv (TTY, not quiet, not json): main menu.
    # --debug is not a command. safe-rm --debug on a TTY is still this menu.
    # Non-interactive / quiet / json, no command: Type O CLI self-install-ensure.
    # Never help. Never a menu under curl | sh. Never treat empty argv as rm.
    # SSOT: requirement-shell-cli-zero-arguments.md
    #       requirement-shell-cli-default-interaction.md
    #       requirement-shell-cli-self-install.md
    _debug_only=1
    for _a in "$@"; do
        case "${_a}" in
            --debug) DEBUG=1 ;;
            *) _debug_only=0 ;;
        esac
    done
    if [ "${_debug_only}" -eq 1 ]; then
        unset _a _debug_only
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
            inst_self_install
            exit $?
        fi
        app_default
        exit $?
    fi
    unset _a _debug_only

    # === Argument parsing: flags and commands (order-independent) ===
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            # --- DOMAIN_DISPATCH_FLAGS (specializee injection) ---
            --dry-run)
                DRY_RUN=1
                ;;
            # --- end DOMAIN_DISPATCH_FLAGS ---
            # --- DOMAIN_DISPATCH_COMMANDS (specializee injection) ---
            *)
                # Bare verb and --verb are one command. rm and --rm break so
                # the remaining words stay the remove argument list.
                _cmd=$(app_token_command "$1") || _cmd=
                if [ -n "$_cmd" ]; then
                    COMMAND=$_cmd
                    if [ "$_cmd" = "rm" ]; then
                        shift
                        unset _cmd
                        break
                    fi
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
            # --- end DOMAIN_DISPATCH_COMMANDS ---
        esac
        shift
    done
    unset _cmd

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE}"

    app_run_command "${COMMAND}" "$@"
}


# =============================================================================
# BOOTSTRAP
# =============================================================================
#
# Always invoke the single dispatcher. Do NOT gate on ${0##*/} matching APP_NAME:
# under curl | sh / stdin pipe, $0 is the shell (sh/bash/…), not the product
# filename — a basename gate causes silent no-op and breaks one-liner install.
# Product law: requirement-shell-cli-zero-arguments.md (Type O) +
# requirement-shell-cli-interface.md (single app_main entry). Historical: INC-20260712-001.
#
# Single-file install CLI: source-as-library is unsupported; main always runs.
# =============================================================================
app_main "$@"

