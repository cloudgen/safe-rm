# =============================================================================
# app_default_ask_rm() - Pick a subfolder or type a path, then the guard
# =============================================================================
#
# Read the choice in this shell. Do not capture read with $().
# Return 0 after the guard runs. Return 1 on EOF. Return 2 on Back
# (nothing was removed; caller reprints the remove-guard board).
# An empty custom path reprints this board and does not call the guard.
# =============================================================================
app_default_ask_rm() {
    : "${APP_NAME:=safe-rm}"
    : "${_menu_json:=${JSON:-0}}"
    : "${_menu_quiet:=${QUIET:-0}}"
    _ad_rc=0
    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        app_default_collect_dirs
        app_default_print_path_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            _ad_rc=1
            break
        fi
        case "${_pick}" in
            0|back|Back|"")
                _ad_rc=2
                break
                ;;
        esac
        _ad_act=""
        _chosen=""
        case "${_pick}" in
            ''|*[!0-9]*)
                if app_default_walk_dirs name "${_pick}"; then
                    _ad_act=folder
                    _chosen=${APP_DEFAULT_DIR_PICK}
                elif [ "${_pick}" = "custom-path" ] || [ "${_pick}" = "custom" ]; then
                    _ad_act=custom
                else
                    _ad_act=bad
                fi
                ;;
            *)
                if [ "${_pick}" = "${APP_DEFAULT_CUSTOM_N}" ]; then
                    _ad_act=custom
                elif app_default_walk_dirs index "${_pick}"; then
                    _ad_act=folder
                    _chosen=${APP_DEFAULT_DIR_PICK}
                else
                    _ad_act=bad
                fi
                ;;
        esac
        case "${_ad_act}" in
            bad)
                out_error "Not a menu choice '${_pick}'. Type a folder number, ${APP_DEFAULT_CUSTOM_N} custom-path, or 0 back."
                continue
                ;;
            custom)
                out_msg_n "Path: "
                _rm_path=""
                if ! read -r _rm_path; then
                    _ad_rc=1
                    break
                fi
                if [ -z "${_rm_path}" ]; then
                    out_error "No path was given. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>"
                    unset _rm_path
                    continue
                fi
                _chosen=${_rm_path}
                unset _rm_path
                ;;
        esac
        JSON=${_menu_json}
        QUIET=${_menu_quiet}
        export JSON QUIET
        srm_cmd_rm "${_chosen}"
        _ad_rc=0
        break
    done
    unset _pick _chosen _ad_act _rm_path
    unset APP_DEFAULT_DIR_LIST APP_DEFAULT_DIR_COUNT APP_DEFAULT_CUSTOM_N
    unset APP_DEFAULT_DIR_PICK APP_DEFAULT_DIR_HERE
    return "${_ad_rc}"
}

# =============================================================================
# app_default_rm_loop() - Remove-guard layer
# =============================================================================
#
# A finished rm returns so the front board redisplays. 0 / back / empty
# returns to the front board without running rm. A bad pick reprints this
# layer. EOF leaves this layer.
# =============================================================================
app_default_rm_loop() {
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        app_default_print_rm_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            unset _pick
            return 0
        fi
        case "${_pick}" in
            0|back|Back|"")
                unset _pick
                return 0
                ;;
            11|rm)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                app_default_ask_rm
                _rc=$?
                JSON=0
                QUIET=0
                export JSON QUIET
                unset _pick
                if [ "${_rc}" -eq 2 ]; then
                    continue
                fi
                unset _rc
                return 0
                ;;
        esac
        JSON=0
        QUIET=0
        export JSON QUIET
        out_error "Not a menu choice '${_pick}'. Type 11, 0 back, or rm."
    done
}

# =============================================================================
# app_default_self_loop() - Self-management layer
# =============================================================================
#
# A finished leaf returns so the front board redisplays. 0 / back / empty
# returns to the front board without running a verb. A bad pick reprints
# this layer. EOF leaves this layer.
# =============================================================================
app_default_self_loop() {
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    while true; do
