# =============================================================================
# srm_* — remove guard (domain prefix)
# =============================================================================
#
# GENERAL PURPOSE:
# Decide whether a path may be removed, say so through out_*, and call the
# system rm only when every path is allowed and --dry-run is off.
#
# Product law: requirement-domain-safe-rm.md
# Output law: requirement-shell-output-requirements.md (product text via out_*)
#
# Class B printf in this section returns a path or a JSON fragment to the
# caller. It is not a user-facing message. User-facing lines use out_*.
#
# =============================================================================
# CIAO-Lite Protection Zone
# Do NOT simplify, refactor, or remove without explicit user instruction
# This section exists for safety and anti-fragility reasons
# --dry-run must never call the system rm
# A refused path must stop the whole command before any removal
# =============================================================================

srm_cleanup_work() {
    _w=${SRM_WORK-}
    [ -n "$_w" ] || return 0
    case "$_w" in
        *..*)
            SRM_WORK=
            return 0
            ;;
    esac
    if [ -n "${HOME-}" ] && [ "$_w" = "$HOME" ]; then
        SRM_WORK=
        return 0
    fi
    case "$_w" in
        /|/home|/usr|/usr/bin|/bin|/etc|/var|/root)
            SRM_WORK=
            return 0
            ;;
    esac
    _ok=0
    case "$_w" in
        /tmp/safe-rm-work.*|/var/tmp/safe-rm-work.*|/dev/shm/safe-rm-work.*)
            _ok=1
            ;;
        *)
            if [ -n "${TMPDIR-}" ]; then
                case "$_w" in
                    "${TMPDIR%/}/safe-rm-work."*)
                        _ok=1
                        ;;
                esac
            fi
            ;;
    esac
    if [ "$_ok" -eq 1 ]; then
        # The remover, not /bin/rm. After setup /bin/rm is this guard.
        if [ -x /usr/bin/origin-rm ]; then
            /usr/bin/origin-rm -rf -- "$_w" 2>/dev/null || true
        elif [ -x /bin/origin-rm ]; then
            /bin/origin-rm -rf -- "$_w" 2>/dev/null || true
        elif [ -x /bin/rm ]; then
            /bin/rm -rf -- "$_w" 2>/dev/null || true
        elif [ -x /usr/bin/rm ]; then
            /usr/bin/rm -rf -- "$_w" 2>/dev/null || true
        fi
    fi
    SRM_WORK=
}

# Return a lexical absolute path on stdout (class B).
srm_lexical_abs() {
    _in=${1-}
    (
        case "$_in" in
            /*) _path=$_in ;;
            *) _path="${PWD%/}/${_in}" ;;
        esac
        _out=""
        _oldifs=$IFS
        IFS=/
        set -f
        # shellcheck disable=SC2086
        set -- $_path
        set +f
        IFS=$_oldifs
        for _seg in "$@"; do
            case "$_seg" in
                ''|.)
                    ;;
                ..)
                    case "$_out" in
                        ''|/) _out="" ;;
                        *) _out=${_out%/*} ;;
                    esac
                    ;;
                *)
                    _out="${_out}/${_seg}"
                    ;;
            esac
        done
        [ -n "$_out" ] || _out=/
        printf '%s\n' "$_out"
    )
}

# Physical directory on stdout (class B).
srm_phys_dir() {
    _d=${1-}
    (CDPATH= cd -P -- "$_d" 2>/dev/null && pwd)
}

# Absolute path on stdout (class B). Missing paths stay lexical.
srm_resolve_path() {
    _raw=${1-}
    [ -n "$_raw" ] || return 1
    if [ -d "$_raw" ]; then
        srm_phys_dir "$_raw"
        return $?
    fi
    if [ -e "$_raw" ] || [ -L "$_raw" ]; then
        _dir=$(dirname -- "$_raw")
        _base=$(basename -- "$_raw")
        _absdir=$(srm_phys_dir "$_dir") || return 1
        _full="${_absdir%/}/${_base}"
        _guard=0
        while [ -L "$_full" ] && [ "$_guard" -lt 16 ]; do
            _tgt=$(readlink -- "$_full" 2>/dev/null) || break
            case "$_tgt" in
                /*) _next=$_tgt ;;
                *) _next=$(srm_lexical_abs "${_full%/*}/${_tgt}") || break ;;
            esac
            if [ -d "$_next" ] && [ ! -L "$_next" ]; then
                _full=$(srm_phys_dir "$_next") || _full=$_next
                break
            fi
            _full=$_next
            _guard=$((_guard + 1))
        done
        if [ -d "$_full" ]; then
            _full=$(srm_phys_dir "$_full") || return 1
        fi
        printf '%s\n' "$_full"
        return 0
    fi
    srm_lexical_abs "$_raw"
}

# Return the refuse sentence on stdout (class B). Caller prints it with out_*.
srm_msg_refuse() {
    _path=${1-}
    _class=${2-}
    case "$_class" in
        DENY-USR-BIN)
            _tp=$(srm_termux_prefix 2>/dev/null || true)
            _said=0
            _look=${3-$_path}
            case "${_look}" in
                */) _look=${_look%/} ;;
            esac
            _name=${_path}
            case "${_name}" in
                */) _name=${_name%/} ;;
            esac
            if [ -n "${_tp}" ]; then
                case "${_name}" in
                    "${_tp}"/bin|"${_tp}"/bin/*) _said=1 ;;
                esac
                case "${_look}" in
                    "${_tp}"/bin|"${_tp}"/bin/*) _said=1 ;;
                esac
                if [ "$_said" -eq 1 ]; then
                    printf '%s\n' "Refusing to remove ${_path}. That path is ${_tp}/bin or something inside it. Removing it breaks programs on this machine. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
                fi
            fi
            if [ "$_said" -eq 0 ]; then
                printf '%s\n' "Refusing to remove ${_path}. That path is /usr/bin or something inside it. Removing it breaks programs on this machine. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            fi
            unset _tp _said _look _name
            ;;
        DENY-LOGIN-HOME)
            printf '%s\n' "Refusing to remove ${_path}. That path is the login home. Removing it destroys files and projects. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} rm --dry-run on a folder inside the login home, such as a cache directory, or stop."
            ;;
        DENY-HOME-USER)
            printf '%s\n' "Refusing to remove ${_path}. That path is /home or a folder under /home outside this login home. Removing it destroys a login's files. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} rm --dry-run on a folder inside this login home, or stop."
            ;;
        DENY-ACCOUNT-HOME)
            printf '%s\n' "Refusing to remove ${_path}. That path is an account home recorded in /etc/passwd. Removing it destroys that login's files, the same way removing the login home does. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} rm --dry-run on a folder inside this login home, such as a cache directory, or stop."
            ;;
        DENY-HOME-ANCESTOR)
            printf '%s\n' "Refusing to remove ${_path}. That path contains the login home. Removing it destroys files and projects. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
        DENY-ROOT|DENY-HOST)
            printf '%s\n' "Refusing to remove ${_path}. That path is a system directory. Removing it can make the machine unusable. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
        DENY-EMPTY)
            printf '%s\n' "Refusing to remove an empty path. Name a real folder. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>."
            ;;
        DENY-STDIN)
            printf '%s\n' "Refusing to remove standard input. This program only checks filesystem paths. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>."
            ;;
        *)
            printf '%s\n' "Refusing to remove ${_path}. The path could not be checked safely. Nothing was removed. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: stop."
            ;;
    esac
}

srm_msg_allow() {
    _path=${1-}
    _exists=${2-}
    _kind=${3-}
    _dry=${4-}
    if [ "$_dry" = true ]; then
        if [ "$_exists" = true ]; then
            printf '%s\n' "Dry-run: ${_path} exists (${_kind}). Removal is allowed. Nothing was removed."
        else
            printf '%s\n' "Dry-run: ${_path} does not exist. Removal would be allowed if it existed. Nothing was removed."
        fi
    else
        if [ "$_exists" = true ]; then
            printf '%s\n' "${_path} exists (${_kind}). Removal is allowed."
        else
            printf '%s\n' "${_path} does not exist. Removal would be allowed if it existed."
        fi
    fi
}

# Rewrite an unexpanded login-home token to the login home path (class B).
# Exact $HOME, ${HOME}, and ~ stay the home directory. A suffix is a folder
# inside that home. Other operands are unchanged.
srm_expand_home_operand() {
    _op=${1-}
    _h=${HOME-}
    if [ -z "$_h" ]; then
        printf '%s\n' "$_op"
        return 0
    fi
    case "$_op" in
        '$HOME'|'${HOME}'|'~')
            printf '%s\n' "$_h"
            ;;
        '$HOME'/*)
            _rest=${_op#"\$HOME/"}
            printf '%s\n' "${_h}/${_rest}"
            ;;
        '${HOME}'/*)
            _rest=${_op#'${HOME}'/}
            printf '%s\n' "${_h}/${_rest}"
            ;;
        '~'/*)
            _rest=${_op#"~/"}
            printf '%s\n' "${_h}/${_rest}"
            ;;
        *)
            printf '%s\n' "$_op"
            ;;
    esac
}

# Record every account home from /etc/passwd and getent passwd (class B side effect).
# The sixth field is the home directory. Empty and "/" are skipped.
srm_load_account_homes() {
    _dest=${1-}
    _raw="${_dest}.raw"
    : > "$_raw"
    if [ -r /etc/passwd ]; then
        while IFS= read -r _line; do
            printf '%s\n' "$_line" >> "$_raw"
        done < /etc/passwd
    fi
    if command -v getent >/dev/null 2>&1; then
        getent passwd >> "$_raw" 2>/dev/null || true
    fi
    : > "$_dest"
    while IFS=: read -r _aname _apw _auid _agid _agecos _ahome _ashell; do
        case "$_aname" in
            ''|'#'*)
                continue
                ;;
        esac
        [ -n "${_ahome-}" ] || continue
        case "$_ahome" in
            /*) ;;
            *) continue ;;
        esac
        [ "$_ahome" = / ] && continue
        if [ -d "$_ahome" ]; then
            _aabs=$(srm_phys_dir "$_ahome") || _aabs=$(srm_lexical_abs "$_ahome")
        else
            _aabs=$(srm_lexical_abs "$_ahome") || continue
        fi
        [ -n "${_aabs-}" ] || continue
        [ "$_aabs" = / ] && continue
        printf '%s\n' "$_aabs" >> "$_dest"
    done < "$_raw"
}

# Return 0 when the resolved path is an account home loaded by srm_load_account_homes.
srm_is_account_home() {
    _apath=${1-}
    _alist=${SRM_WORK-}/homes
    [ -n "$_apath" ] || return 1
    [ -f "$_alist" ] || return 1
    while IFS= read -r _aline; do
        [ -n "$_aline" ] || continue
        [ "$_apath" = "$_aline" ] && return 0
    done < "$_alist"
    return 1
}

# Sets SRM_RAW SRM_RESOLVED SRM_EXISTS SRM_KIND SRM_CLASS SRM_VERDICT SRM_MESSAGE.
srm_classify() {
    SRM_RAW=${1-}
    SRM_RESOLVED=
    SRM_EXISTS=false
    SRM_KIND=missing
    SRM_CLASS=ALLOW
    SRM_VERDICT=allow
    SRM_MESSAGE=

    case "$SRM_RAW" in
        '')
            SRM_CLASS=DENY-EMPTY
            SRM_VERDICT=refuse
            SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
            return 0
            ;;
        -)
            SRM_CLASS=DENY-STDIN
            SRM_VERDICT=refuse
            SRM_RESOLVED=-
            SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
            return 0
            ;;
        '$HOME'|'${HOME}'|'~')
            SRM_CLASS=DENY-LOGIN-HOME
            SRM_VERDICT=refuse
            SRM_RESOLVED=$SRM_RAW
            SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS")
            return 0
            ;;
    esac

    SRM_RESOLVED=$(srm_resolve_path "$SRM_RAW") || {
        SRM_RESOLVED=$(srm_lexical_abs "$SRM_RAW") || SRM_RESOLVED=$SRM_RAW
        _home=$(srm_resolve_path "${HOME}") || _home=$(srm_lexical_abs "${HOME}")
        if [ "$SRM_RESOLVED" = "$_home" ]; then
            SRM_CLASS=DENY-LOGIN-HOME
        elif srm_is_account_home "$SRM_RESOLVED"; then
            SRM_CLASS=DENY-ACCOUNT-HOME
        else
            SRM_CLASS=DENY-UNRESOLVED
        fi
        _tclass=$(srm_termux_guard_class "$SRM_RESOLVED" 2>/dev/null || true)
        if [ -n "${_tclass}" ]; then
            case "$SRM_CLASS" in
                DENY-LOGIN-HOME|DENY-ACCOUNT-HOME)
                    ;;
                *)
                    SRM_CLASS=$_tclass
                    ;;
            esac
        fi
        unset _tclass
        SRM_VERDICT=refuse
        SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS" "$SRM_RESOLVED")
        return 0
    }

    if [ -d "$SRM_RESOLVED" ]; then
        SRM_KIND=dir
        SRM_EXISTS=true
    elif [ -L "$SRM_RESOLVED" ]; then
        SRM_KIND=link
        SRM_EXISTS=true
    elif [ -f "$SRM_RESOLVED" ]; then
        SRM_KIND=file
        SRM_EXISTS=true
    elif [ -e "$SRM_RESOLVED" ]; then
        SRM_KIND=other
        SRM_EXISTS=true
    else
        SRM_KIND=missing
        SRM_EXISTS=false
    fi

    _home=$(srm_resolve_path "${HOME}") || _home=$(srm_lexical_abs "${HOME}")

    case "$SRM_RESOLVED" in
        /)
            SRM_CLASS=DENY-ROOT
            ;;
        /usr/bin|/usr/bin/*)
            SRM_CLASS=DENY-USR-BIN
            ;;
        /home|/home/*)
            SRM_CLASS=DENY-HOME-USER
            ;;
        /usr|/bin|/sbin|/etc|/var|/boot|/root|/lib|/lib64|/opt|/dev|/proc|/sys)
            SRM_CLASS=DENY-HOST
            ;;
        *)
            SRM_CLASS=ALLOW
            ;;
    esac

    _tclass=$(srm_termux_guard_class "$SRM_RESOLVED" 2>/dev/null || true)
    if [ -z "${_tclass}" ]; then
        _lex=$(srm_lexical_abs "$SRM_RAW" 2>/dev/null || true)
        if [ -n "${_lex}" ] && [ "${_lex}" != "$SRM_RESOLVED" ]; then
            _tclass=$(srm_termux_guard_class "$_lex" 2>/dev/null || true)
        fi
        unset _lex
    fi
    if [ -n "${_tclass}" ]; then
        case "$SRM_CLASS" in
            DENY-ROOT|DENY-HOME-ANCESTOR)
                ;;
            *)
                SRM_CLASS=$_tclass
                ;;
        esac
    fi
    unset _tclass

    if [ "$SRM_RESOLVED" = "$_home" ]; then
        SRM_CLASS=DENY-LOGIN-HOME
    fi
    case "$_home" in
        "$SRM_RESOLVED"/*)
            SRM_CLASS=DENY-HOME-ANCESTOR
            ;;
    esac
    # The login home itself stays refused. A folder strictly inside it is
    # allowed, including when that folder also sits under /home. Do not lift
    # a system-directory refusal, and do not treat children of / as inside
    # a login home of /.
    if [ -n "$_home" ] && [ "$_home" != / ]; then
        case "$SRM_RESOLVED" in
            "$_home"/*)
                case "$SRM_CLASS" in
                    DENY-ROOT|DENY-USR-BIN|DENY-HOST|DENY-HOME-ANCESTOR)
                        ;;
                    *)
                        SRM_CLASS=ALLOW
                        ;;
                esac
                ;;
        esac
    fi
    # Every account home in /etc/passwd is refused the same way as the login
    # home. A named folder inside this login home stays allowed unless that
    # folder is itself some account's home directory.
    if srm_is_account_home "$SRM_RESOLVED"; then
        if [ "$SRM_RESOLVED" = "$_home" ]; then
            SRM_CLASS=DENY-LOGIN-HOME
        else
            case "$SRM_CLASS" in
                DENY-ROOT|DENY-USR-BIN|DENY-HOME-ANCESTOR|DENY-LOGIN-HOME)
                    ;;
                *)
                    SRM_CLASS=DENY-ACCOUNT-HOME
                    ;;
            esac
        fi
    fi

    if [ "$SRM_CLASS" = ALLOW ]; then
        SRM_VERDICT=allow
        if [ "${DRY_RUN:-0}" -eq 1 ]; then
            SRM_MESSAGE=$(srm_msg_allow "$SRM_RAW" "$SRM_EXISTS" "$SRM_KIND" true)
        else
            SRM_MESSAGE=$(srm_msg_allow "$SRM_RAW" "$SRM_EXISTS" "$SRM_KIND" false)
        fi
    else
        SRM_VERDICT=refuse
        SRM_MESSAGE=$(srm_msg_refuse "$SRM_RAW" "$SRM_CLASS" "$SRM_RESOLVED")
    fi
}

# One JSON object on stdout (class B). Inserted via out_json @results.
srm_json_item() {
    printf '{'
    printf '"path":"%s"' "$(util_json_escape "${1-}")"
    printf ',"resolved":"%s"' "$(util_json_escape "${2-}")"
    printf ',"exists":"%s"' "$(util_json_escape "${3-}")"
    printf ',"kind":"%s"' "$(util_json_escape "${4-}")"
    printf ',"verdict":"%s"' "$(util_json_escape "${5-}")"
    printf ',"class":"%s"' "$(util_json_escape "${6-}")"
    printf ',"message":"%s"' "$(util_json_escape "${7-}")"
    printf '}'
}

# Basename rm is the command people type after setup. Not a gate that skips app_main.
srm_invoked_as_rm() {
    _b=${0##*/}
    [ "$_b" = "rm" ]
    _rc=$?
    unset _b
    return $_rc
}

srm_flags_need_prompt() {
    [ -f "${SRM_WORK}/flags" ] || return 1
    while IFS= read -r _f; do
        case "$_f" in
            --interactive=never)
                ;;
            --interactive|--interactive=always|--interactive=once)
                return 0
                ;;
            --*)
                ;;
            -*)
                _rest=${_f#-}
                case "$_rest" in
                    *i*) return 0 ;;
                esac
                ;;
        esac
    done < "${SRM_WORK}/flags"
    return 1
}

# A stored remover info switch removes nothing.
# Lifecycle --help and --version are commands. They are not stored here.
srm_flags_request_info() {
    [ -f "${SRM_WORK}/flags" ] || return 1
    while IFS= read -r _f; do
        case "$_f" in
            --help|--version) return 0 ;;
        esac
    done < "${SRM_WORK}/flags"
    return 1
}

# Remover after the swap.
# Linux: /usr/bin/origin-rm or /bin/origin-rm.
# Termux: $PREFIX/bin/origin-rm. which rm is $PREFIX/bin/rm.
# Before the swap, the original file still named rm.
# Path on stdout (class B). Never returns a symlink to this program.
srm_origin_rm() {
    _self=$0
    _tprefix=$(srm_termux_prefix 2>/dev/null || true)
    if [ -n "${_tprefix}" ]; then
        _c="${_tprefix}/bin/origin-rm"
        if [ -x "$_c" ] && [ ! -L "$_c" ]; then
            printf '%s\n' "$_c"
            unset _self _list _c _t _tprefix
            return 0
        fi
        _c="${_tprefix}/bin/rm"
        if [ -x "$_c" ] && [ "$_c" != "$_self" ]; then
            _skip=0
            if [ -L "$_c" ]; then
                _t=$(readlink -- "$_c" 2>/dev/null || true)
                case "$_t" in
                    *safe-rm*) _skip=1 ;;
                esac
            fi
            if [ "$_skip" -eq 0 ]; then
                printf '%s\n' "$_c"
                unset _self _list _c _t _tprefix _skip
                return 0
            fi
            unset _skip
        fi
        unset _self _list _c _t _tprefix
        return 1
    fi
    _list="/usr/bin/origin-rm /bin/origin-rm"
    if [ -n "${SRM_SWAP_BIN-}" ]; then
        _list="${SRM_SWAP_BIN}/origin-rm ${_list}"
    fi
    if [ -n "${SRM_SWAP_ROOT-}" ]; then
        _list="${SRM_SWAP_ROOT}/origin-rm ${_list}"
    fi
    for _c in ${_list}; do
        [ -x "$_c" ] || continue
        [ -L "$_c" ] && continue
        printf '%s\n' "$_c"
        unset _self _list _c _t
        return 0
    done
    for _c in /bin/rm /usr/bin/rm; do
        [ -x "$_c" ] || continue
        if [ "$_c" = "$_self" ]; then
            continue
        fi
        if [ -L "$_c" ]; then
            _t=$(readlink -- "$_c" 2>/dev/null || true)
            case "$_t" in
                *safe-rm*) continue ;;
            esac
        fi
        printf '%s\n' "$_c"
        unset _self _list _c _t
        return 0
    done
    unset _self _list _c _t
    return 1
}

# Drop a symlink. Refuse a directory. Do not call rm.
srm_drop_symlink() {
    _p=${1-}
    [ -n "$_p" ] || return 0
    [ -L "$_p" ] || return 0
    if [ -d "$_p" ]; then
        unset _p
        return 1
    fi
    unlink -- "$_p" 2>/dev/null || unlink "$_p" 2>/dev/null || return 1
    unset _p
    return 0
}

# Copy this program onto the guard path. Do not call rm.
# Same bytes: say so and leave the file. Absent: install. Different: replace.
srm_install_guard() {
    _ig_src=${1-}
    _ig_guard=${2-}
    if [ -z "$_ig_src" ] || [ ! -f "$_ig_src" ]; then
        out_die "Could not find this program file to install as safe-rm. Nothing was moved."
    fi
    if [ -d "$_ig_guard" ]; then
        out_die "Refusing to replace a directory at ${_ig_guard}. Nothing was moved."
    fi
    if [ -f "$_ig_guard" ] && cmp -s "$_ig_src" "$_ig_guard"; then
        out_info "Guard is already this program: ${_ig_guard}"
        unset _ig_src _ig_guard
        return 0
    fi
    _ig_dir=${_ig_guard%/*}
    [ -d "$_ig_dir" ] || out_die "Setup directory is missing. Nothing was moved."
    _ig_tmp=$(mktemp "${_ig_dir}/safe-rm.XXXXXX") || out_die "Could not stage a copy of this program. Nothing else was changed."
    if ! cp -- "$_ig_src" "$_ig_tmp"; then
        unlink -- "$_ig_tmp" 2>/dev/null || unlink "$_ig_tmp" 2>/dev/null || true
        out_die "Could not copy this program to ${_ig_guard}."
    fi
    chmod 0755 "$_ig_tmp" 2>/dev/null || true
    if [ -e "$_ig_guard" ]; then
        _ig_verb="Replaced"
    else
        _ig_verb="Installed"
    fi
    if ! mv -- "$_ig_tmp" "$_ig_guard"; then
        unlink -- "$_ig_tmp" 2>/dev/null || unlink "$_ig_tmp" 2>/dev/null || true
        out_die "Could not copy this program to ${_ig_guard}."
    fi
    out_info "${_ig_verb} ${_ig_guard}"
    unset _ig_src _ig_guard _ig_dir _ig_tmp _ig_verb
    return 0
}

# Termux rm is $PREFIX/bin/rm. which rm prints
# /data/data/com.termux/files/usr/bin/rm. That is not /usr/bin/rm or /bin/rm.
# Live: TERMUX_VERSION, or PREFIX under /data/*/com.termux/files/usr,
# or uname containing Android, and that bin directory exists.
# Tests pass SRM_TERMUX_PREFIX=/tmp/safe-rm-swap.* and do not touch the host.
srm_termux_prefix() {
    if [ -n "${SRM_TERMUX_PREFIX-}" ]; then
        case "${SRM_TERMUX_PREFIX}" in
            /tmp/safe-rm-swap.*) ;;
            *)
                return 1
                ;;
        esac
        case "${SRM_TERMUX_PREFIX}" in
            *..*) return 1 ;;
        esac
        if [ -n "${HOME-}" ] && [ "${SRM_TERMUX_PREFIX}" = "${HOME}" ]; then
            return 1
        fi
        [ -d "${SRM_TERMUX_PREFIX}" ] || return 1
        printf '%s\n' "${SRM_TERMUX_PREFIX}"
        return 0
    fi
    _hit=0
    if [ -n "${TERMUX_VERSION-}" ]; then
        _hit=1
    fi
    if [ "$_hit" -eq 0 ] && [ -n "${PREFIX-}" ]; then
        case "${PREFIX}" in
            /data/*/com.termux/files/usr|/data/*/com.termux/files/usr/)
                _hit=1
                ;;
        esac
    fi
    if [ "$_hit" -eq 0 ]; then
        _ua=$(uname -a 2>/dev/null || true)
        case "$_ua" in
            *[Aa]ndroid*) _hit=1 ;;
        esac
        unset _ua
    fi
    if [ "$_hit" -eq 0 ]; then
        unset _hit
        return 1
    fi
    unset _hit
    _tp=${PREFIX:-/data/data/com.termux/files/usr}
    case "${_tp}" in
        */) _tp=${_tp%/} ;;
    esac
    case "${_tp}" in
        *..*)
            unset _tp
            return 1
            ;;
    esac
    case "${_tp}" in
        /data/*/com.termux/files/usr) ;;
        *)
            unset _tp
            return 1
            ;;
    esac
    if [ ! -d "${_tp}/bin" ]; then
        unset _tp
        return 1
    fi
    printf '%s\n' "${_tp}"
    unset _tp
    return 0
}

# Termux form of the Linux blacklist. $PREFIX stands for /usr.
# $PREFIX/bin stands for /usr/bin, /bin, and /sbin, including everything inside bin.
# The other names are exact, the same way /var is exact and /var/log is not.
# Class name on stdout. Return 1 when the path is not on this list.
srm_termux_guard_class() {
    _p=${1-}
    _tp=$(srm_termux_prefix 2>/dev/null || true)
    if [ -z "${_tp}" ] || [ -z "${_p}" ]; then
        unset _p _tp
        return 1
    fi
    case "${_p}" in
        */) _p=${_p%/} ;;
    esac
    case "${_p}" in
        "${_tp}"/bin|"${_tp}"/bin/*)
            printf '%s\n' DENY-USR-BIN
            ;;
        "${_tp}"|"${_tp}"/etc|"${_tp}"/var|"${_tp}"/lib|"${_tp}"/lib64|"${_tp}"/opt|"${_tp}"/sbin|"${_tp}"/boot)
            printf '%s\n' DENY-HOST
            ;;
        *)
            unset _p _tp
            return 1
            ;;
    esac
    unset _p _tp
    return 0
}

# Termux, Git Bash, and Windows cmd do not refresh /usr/bin.
# Termux refreshes $PREFIX/bin when origin-rm is already there.
srm_swap_host_skipped() {
    if [ -n "${TERMUX_VERSION-}" ] || [ -n "${MSYSTEM-}" ]; then
        return 0
    fi
    case "$(uname -s 2>/dev/null)" in
        Linux) ;;
        *)
            return 0
            ;;
    esac
    return 1
}

# Root place only. Does not move rm. When origin-rm is already there, the
# command people type is the guard in that directory, not GLOBAL_BIN.
srm_place_refreshes_guard() {
    _tprefix=$(srm_termux_prefix 2>/dev/null || true)
    if [ -n "${_tprefix}" ]; then
        if [ -e "${_tprefix}/bin/origin-rm" ]; then
            _pg_src=$(srm_script_source 2>/dev/null || true)
            if [ -z "${_pg_src}" ] || [ ! -f "${_pg_src}" ]; then
                _pg_src=${INSTALL_PATH-}
            fi
            if [ -n "${_pg_src}" ] && [ -f "${_pg_src}" ]; then
                srm_install_guard "${_pg_src}" "${_tprefix}/bin/safe-rm"
            fi
            unset _pg_src
        fi
        unset _tprefix
        return 0
    fi
    unset _tprefix
    if srm_swap_host_skipped; then
        return 0
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        return 0
    fi
    _pg_src=$(srm_script_source 2>/dev/null || true)
    if [ -z "${_pg_src}" ] || [ ! -f "${_pg_src}" ]; then
        _pg_src=${INSTALL_PATH-}
    fi
    if [ -z "${_pg_src}" ] || [ ! -f "${_pg_src}" ]; then
        unset _pg_src
        return 0
    fi
    if [ -e /usr/bin/origin-rm ]; then
        srm_install_guard "${_pg_src}" "/usr/bin/safe-rm"
    fi
    if [ -d /bin ] && ! srm_same_file /bin /usr/bin; then
        if [ -e /bin/origin-rm ]; then
            srm_install_guard "${_pg_src}" "/bin/safe-rm"
        fi
    fi
    unset _pg_src
    return 0
}

# Symlink text when $1 is a link whose target name is busybox. Empty otherwise.
srm_busybox_link_text() {
    _bl=${1-}
    _want=${2:-busybox}
    [ -n "$_bl" ] || return 1
    [ -L "$_bl" ] || return 1
    _bt=$(readlink -- "$_bl" 2>/dev/null || readlink "$_bl" 2>/dev/null || true)
    [ -n "$_bt" ] || {
        unset _bl _bt
        return 1
    }
    case "$_bt" in
        *'
'*)
            unset _bl _bt
            return 1
            ;;
    esac
    _bb=${_bt##*/}
    if [ "$_bb" != "${_want}" ]; then
        unset _bl _bt _bb _want
        return 1
    fi
    printf '%s\n' "$_bt"
    unset _bl _bt _bb _want
    return 0
}

# Absolute busybox path. $1 is the rm link. $2 is its stored target text.
srm_busybox_abs() {
    _ba_link=${1-}
    _ba_text=${2-}
    case "$_ba_text" in
        /*)
            printf '%s\n' "$_ba_text"
            ;;
        *)
            printf '%s\n' "${_ba_link%/*}/${_ba_text}"
            ;;
    esac
    unset _ba_link _ba_text
}

# BusyBox picks its applet from the file name. origin-rm must run `busybox rm`.
# The stored link text is what restore puts back.
srm_install_busybox_origin() {
    _bo_origin=${1-}
    _bo_text=${2-}
    _bo_abs=${3-}
    _bo_kind=${4:-busybox}
    _bo_dir=${_bo_origin%/*}
    _bo_tmp=$(mktemp "${_bo_dir}/origin-rm.XXXXXX") || out_die "Could not stage origin-rm. Nothing else was changed."
    if [ "${_bo_kind}" = "busybox" ]; then
        _bo_mark='safe-rm busybox-origin'
        _bo_msg="Kept BusyBox rm as ${_bo_origin}"
    else
        _bo_mark='safe-rm applet-origin'
        _bo_msg="Kept ${_bo_kind} rm as ${_bo_origin}"
    fi
    if ! printf '%s\n' '#!/bin/sh' "# ${_bo_mark}" "# link: ${_bo_text}" "exec '${_bo_abs}' rm \"\$@\"" > "${_bo_tmp}"; then
        unlink -- "$_bo_tmp" 2>/dev/null || unlink "$_bo_tmp" 2>/dev/null || true
        out_die "Could not write ${_bo_origin}. Nothing else was changed."
    fi
    chmod 0755 "$_bo_tmp" 2>/dev/null || true
    if ! mv -- "$_bo_tmp" "$_bo_origin"; then
        unlink -- "$_bo_tmp" 2>/dev/null || unlink "$_bo_tmp" 2>/dev/null || true
        out_die "Could not write ${_bo_origin}. Nothing else was changed."
    fi
    out_info "${_bo_msg}"
    unset _bo_origin _bo_text _bo_abs _bo_kind _bo_dir _bo_tmp _bo_mark _bo_msg
    return 0
}

srm_origin_is_busybox() {
    _ob=${1-}
    [ -n "$_ob" ] || return 1
    [ -f "$_ob" ] || return 1
    if [ -L "$_ob" ]; then
        unset _ob
        return 1
    fi
    if grep -q 'safe-rm busybox-origin' "$_ob" 2>/dev/null; then
        unset _ob
        return 0
    fi
    if grep -q 'safe-rm applet-origin' "$_ob" 2>/dev/null; then
        unset _ob
        return 0
    fi
    unset _ob
    return 1
}

# One directory of the before/after table. Does not delete a directory.
# Returns 1 when this directory has no rm to move. The caller checks the
# other of /usr/bin/rm and /bin/rm. A BusyBox symlink is not renamed to
# origin-rm: that name would not run the rm applet.
srm_swap_one() {
    _dir=${1-}
    _src=${2-}
    [ -d "$_dir" ] || {
        out_die "Setup directory is missing. Nothing was moved."
    }
    _rm="${_dir}/rm"
    _origin="${_dir}/origin-rm"
    _guard="${_dir}/safe-rm"
    if [ -e "$_origin" ]; then
        out_info "Already swapped: ${_origin}"
    elif [ -f "$_rm" ] && [ ! -L "$_rm" ]; then
        if ! mv -- "$_rm" "$_origin"; then
            out_die "Could not move ${_rm} to ${_origin}. Nothing else was changed."
        fi
        out_info "Moved ${_rm} to ${_origin}"
    else
        _bb_text=$(srm_busybox_link_text "$_rm" 2>/dev/null || true)
        _bb_kind=busybox
        if [ -z "${_bb_text}" ]; then
            _bb_text=$(srm_busybox_link_text "$_rm" toybox 2>/dev/null || true)
            _bb_kind=toybox
        fi
        if [ -z "${_bb_text}" ]; then
            _bb_text=$(srm_busybox_link_text "$_rm" coreutils 2>/dev/null || true)
            _bb_kind=coreutils
        fi
        if [ -n "${_bb_text}" ]; then
            _bb_abs=$(srm_busybox_abs "$_rm" "$_bb_text")
            if [ ! -f "$_bb_abs" ]; then
                out_die "${_bb_kind} rm at ${_rm} does not point at a usable ${_bb_abs}. Nothing was moved."
            fi
            srm_install_busybox_origin "$_origin" "$_bb_text" "$_bb_abs" "${_bb_kind}"
            unset _bb_text _bb_abs _bb_kind
        elif [ ! -e "$_rm" ] || [ -L "$_rm" ]; then
            out_info "No original rm at ${_rm}."
            unset _dir _src _rm _origin _guard _bb_text _bb_abs _bb_kind
            return 1
        else
            out_die "No original rm binary in ${_dir}. Nothing was moved."
        fi
    fi
    # Absent: first copy. Present: replace, so a later setup is not a stale guard.
    srm_install_guard "$_src" "$_guard"
    if [ -L "$_rm" ] || [ ! -e "$_rm" ]; then
        srm_drop_symlink "$_rm" || out_die "Could not replace the rm link in ${_dir}."
        ln -s "$_guard" "$_rm" || out_die "Could not point ${_rm} at ${_guard}."
        out_info "Pointed ${_rm} at ${_guard}"
    else
        out_info "Left ${_rm} in place because ${_origin} already exists."
    fi
    unset _dir _src _rm _origin _guard
    return 0
}

# Check both rm paths. One empty directory does not cancel the other.
srm_swap_either() {
    _ea=${1-}
    _eb=${2-}
    _es=${3-}
    _esame=0
    _ea_ok=0
    _eb_ok=0
    if srm_same_file "$_ea" "$_eb"; then
        _esame=1
    elif srm_same_file "${_ea}/rm" "${_eb}/rm"; then
        _esame=1
    fi
    if srm_swap_one "$_ea" "$_es"; then
        _ea_ok=1
    fi
    if [ "$_esame" -eq 1 ]; then
        if [ "$_ea_ok" -eq 1 ]; then
            out_info "/bin and /usr/bin are the same file. One origin-rm covers both."
            unset _ea _eb _es _esame _ea_ok _eb_ok
            return 0
        fi
        out_die "No original rm at ${_ea}/rm or ${_eb}/rm. Nothing was moved."
    fi
    if srm_swap_one "$_eb" "$_es"; then
        _eb_ok=1
    fi
    if [ "$_ea_ok" -eq 0 ] && [ "$_eb_ok" -eq 0 ]; then
        out_die "No original rm at ${_ea}/rm or ${_eb}/rm. Nothing was moved."
    fi
    unset _ea _eb _es _esame _ea_ok _eb_ok
    return 0
}

srm_restore_one() {
    _dir=${1-}
    [ -d "$_dir" ] || out_die "Restore directory is missing. Nothing was moved."
    _rm="${_dir}/rm"
    _origin="${_dir}/origin-rm"
    _guard="${_dir}/safe-rm"
    if [ ! -e "$_origin" ]; then
        unset _dir _rm _origin _guard
        return 1
    fi
    if srm_origin_is_busybox "$_origin"; then
        _ol=$(grep '^# link: ' "$_origin" 2>/dev/null | head -n 1)
        _ol=${_ol#"# link: "}
        if [ -z "${_ol}" ]; then
            out_die "Could not restore the original link at ${_rm}. Nothing was moved."
        fi
        if [ -L "$_rm" ]; then
            srm_drop_symlink "$_rm" || out_die "Could not remove the rm link in ${_dir}."
        elif [ -e "$_rm" ]; then
            out_die "Refusing to restore over an existing ${_rm}. Nothing was moved."
        fi
        ln -s "$_ol" "$_rm" || out_die "Could not restore ${_rm}."
        if ! unlink -- "$_origin" 2>/dev/null; then
            if ! unlink "$_origin" 2>/dev/null; then
                out_die "Could not remove ${_origin}."
            fi
        fi
        out_success "Restored ${_rm}"
        unset _ol
    else
        if [ -L "$_rm" ]; then
            srm_drop_symlink "$_rm" || out_die "Could not remove the rm link in ${_dir}."
        elif [ -e "$_rm" ]; then
            out_die "Refusing to restore over an existing ${_rm}. Nothing was moved."
        fi
        mv -- "$_origin" "$_rm" || out_die "Could not move ${_origin} back to ${_rm}."
        out_success "Restored ${_rm}"
    fi
    if [ -L "$_guard" ] || [ -f "$_guard" ]; then
        if [ -L "$_guard" ]; then
            srm_drop_symlink "$_guard" || true
        else
            unlink -- "$_guard" 2>/dev/null || unlink "$_guard" 2>/dev/null || true
        fi
    fi
    unset _dir _rm _origin _guard
    return 0
}

srm_swap_root_ok() {
    _r=${1-}
    case "$_r" in
        /tmp/safe-rm-swap.*) ;;
        *)
            unset _r
            return 1
            ;;
    esac
    case "$_r" in
        *..*) unset _r; return 1 ;;
    esac
    [ -d "$_r" ] || { unset _r; return 1; }
    if [ -n "${HOME-}" ] && [ "$_r" = "${HOME}" ]; then
        unset _r
        return 1
    fi
    unset _r
    return 0
}

srm_same_file() {
    _a=${1-}
    _b=${2-}
    [ -e "$_a" ] && [ -e "$_b" ] || return 1
    _ia=$(stat -c '%d:%i' "$_a" 2>/dev/null || true)
    _ib=$(stat -c '%d:%i' "$_b" 2>/dev/null || true)
    [ -n "$_ia" ] && [ "$_ia" = "$_ib" ]
    _rc=$?
    unset _a _b _ia _ib
    return $_rc
}

srm_script_source() {
    _src=$(inst_resolve_self_script "$0" 2>/dev/null || true)
    if [ -z "$_src" ] || [ ! -f "$_src" ]; then
        _src=$0
    fi
    if [ ! -f "$_src" ]; then
        unset _src
        return 1
    fi
    printf '%s\n' "$_src"
    unset _src
}

srm_cmd_setup() {
    _src=$(srm_script_source) || out_die "Could not find this program file to install as safe-rm. Nothing was moved."
    if [ -n "${SRM_SWAP_ROOT-}" ] || [ -n "${SRM_SWAP_BIN-}" ]; then
        if [ -n "${SRM_SWAP_ROOT-}" ]; then
            srm_swap_root_ok "${SRM_SWAP_ROOT}" || out_die "Refusing setup outside a /tmp/safe-rm-swap.* directory. Nothing was moved."
        fi
        if [ -n "${SRM_SWAP_BIN-}" ]; then
            srm_swap_root_ok "${SRM_SWAP_BIN}" || out_die "Refusing setup outside a /tmp/safe-rm-swap.* directory. Nothing was moved."
        fi
        if [ -n "${SRM_SWAP_ROOT-}" ] && [ -n "${SRM_SWAP_BIN-}" ]; then
            srm_swap_either "${SRM_SWAP_ROOT}" "${SRM_SWAP_BIN}" "$_src"
        else
            _one=${SRM_SWAP_ROOT:-${SRM_SWAP_BIN}}
            if ! srm_swap_one "$_one" "$_src"; then
                out_die "No original rm binary in ${_one}. Nothing was moved."
            fi
            unset _one
        fi
        unset _src
        return 0
    fi
    _tprefix=$(srm_termux_prefix 2>/dev/null || true)
    if [ -n "${_tprefix}" ]; then
        _tbin="${_tprefix}/bin"
        if [ ! -d "${_tbin}" ]; then
            out_die "Termux rm is ${_tbin}/rm. That directory is missing. Nothing was moved."
        fi
        if ! srm_swap_one "${_tbin}" "$_src"; then
            out_die "No original rm at ${_tbin}/rm. Nothing was moved."
        fi
        unset _tprefix _tbin _src
        return 0
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        out_die "Setup checks /usr/bin/rm and /bin/rm and may move the system rm. That needs an admin login. Nothing was moved."
    fi
    srm_swap_either "/usr/bin" "/bin" "$_src"
    unset _src
    return 0
}

srm_cmd_restore() {
    if [ -n "${SRM_SWAP_ROOT-}" ] || [ -n "${SRM_SWAP_BIN-}" ]; then
        _rdid=0
        if [ -n "${SRM_SWAP_ROOT-}" ]; then
            srm_swap_root_ok "${SRM_SWAP_ROOT}" || out_die "Refusing restore outside a /tmp/safe-rm-swap.* directory. Nothing was moved."
            if srm_restore_one "${SRM_SWAP_ROOT}"; then
                _rdid=1
            fi
        fi
        if [ -n "${SRM_SWAP_BIN-}" ]; then
            srm_swap_root_ok "${SRM_SWAP_BIN}" || out_die "Refusing restore outside a /tmp/safe-rm-swap.* directory. Nothing was moved."
            if srm_restore_one "${SRM_SWAP_BIN}"; then
                _rdid=1
            fi
        fi
        if [ "$_rdid" -eq 0 ]; then
            out_die "No origin-rm to restore. Nothing was moved."
        fi
        unset _rdid
        return 0
    fi
    _tprefix=$(srm_termux_prefix 2>/dev/null || true)
    if [ -n "${_tprefix}" ]; then
        if ! srm_restore_one "${_tprefix}/bin"; then
            out_die "No origin-rm at ${_tprefix}/bin/origin-rm. Nothing was moved."
        fi
        unset _tprefix
        return 0
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        out_die "Restore puts origin-rm back as rm. That needs an admin login. Nothing was moved."
    fi
    _rdid=0
    if [ -e /usr/bin/origin-rm ]; then
        if srm_restore_one "/usr/bin"; then
            _rdid=1
        fi
    fi
    if [ -d /bin ] && ! srm_same_file /bin /usr/bin; then
        if [ -e /bin/origin-rm ]; then
            if srm_restore_one "/bin"; then
                _rdid=1
            fi
        fi
    fi
    if [ "$_rdid" -eq 0 ]; then
        out_die "No origin-rm at /usr/bin/origin-rm or /bin/origin-rm. Nothing was moved."
    fi
    unset _rdid
    return 0
}

# !!! DO NOT MODIFY OR SIMPLIFY THE DRY-RUN GUARD !!!
# --dry-run must return before any origin-rm.
# One exec: every forwarded switch, then --, then every allowed path.
# _fwd_paths 0 forwards switches only. No paths.
srm_exec_forward() {
    _fwd_origin=${1-}
    _fwd_paths=${2-}
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        out_die "Dry-run tried to remove a path. Nothing was removed. STOP. Next: ${APP_NAME} rm --dry-run <path>"
    fi
    set -- "$_fwd_origin"
    if [ -f "${SRM_WORK}/flags" ]; then
        while IFS= read -r _fwd_flag; do
            [ -n "$_fwd_flag" ] || continue
            set -- "$@" "$_fwd_flag"
        done < "${SRM_WORK}/flags"
    fi
    if [ "$_fwd_paths" -eq 1 ]; then
        set -- "$@" "--"
        _fwd_i=1
        while [ "$_fwd_i" -le "${_n:-0}" ]; do
            IFS= read -r _fwd_path < "${SRM_WORK}/path.${_fwd_i}" || _fwd_path=
            set -- "$@" "$_fwd_path"
            _fwd_i=$((_fwd_i + 1))
        done
    fi
    "$@"
}

srm_emit_json() {
    _summary=${1-}
    _dry=${2-}
    _removed=${3-}
    _ok=${4-}
    _items=${5-}
    if [ "${JSON:-0}" -eq 1 ]; then
        out_json "rm" "$_summary" \
            "dry_run" "$_dry" \
            "removed" "$_removed" \
            "ok" "$_ok" \
            "@results" "[${_items}]"
    fi
}

srm_cmd_rm() {
    : "${DRY_RUN:=0}"
    : "${JSON:=0}"
    : "${APP_NAME:=safe-rm}"

    SRM_WORK=$(mktemp -d "${TMPDIR:-/tmp}/safe-rm-work.XXXXXX") || {
        out_die "Could not create a scratch directory for the remove check. Nothing was removed. Next: check that the temp directory is writable."
    }
    trap 'srm_cleanup_work' EXIT INT HUP TERM
    : > "${SRM_WORK}/flags"
    srm_load_account_homes "${SRM_WORK}/homes"

    _n=0
    _end=0
    _verb=
    _saw_force=0
    _saw_q=0
    while [ $# -gt 0 ]; do
        _arg=$1
        shift
        if [ "$_end" -eq 0 ]; then
            case "$_arg" in
                --dry-run)
                    DRY_RUN=1
                    continue
                    ;;
                --)
                    _end=1
                    continue
                    ;;
                --quiet)
                    QUIET=1
                    continue
                    ;;
                --json)
                    JSON=1
                    QUIET=1
                    continue
                    ;;
                --debug)
                    DEBUG=1
                    continue
                    ;;
                --force)
                    # Remove: the remover's --force, written after this loop.
                    # Lifecycle verb: reinstall force. Not a path.
                    _saw_force=1
                    continue
                    ;;
                -q)
                    # Remove: forward. The remover has no -q.
                    # Lifecycle verb: quiet.
                    _saw_q=1
                    continue
                    ;;
                -)
                    ;;
                *)
                    # A --switch is the lifecycle command (version → --version).
                    # A bare word is a path, so `rm version` removes a link named version.
                    # -restore stays the 2023 token. The word rm stays a path.
                    case "$_arg" in
                        -*)
                            _tok=$(app_token_command "$_arg") || _tok=
                            if [ -n "$_tok" ] && [ "$_tok" != "rm" ]; then
                                _verb=$_tok
                                continue
                            fi
                            # Any remover switch, including clustered -rf. Forward unchanged.
                            printf '%s\n' "$_arg" >> "${SRM_WORK}/flags"
                            continue
                            ;;
                    esac
                    ;;
            esac
        fi
        _n=$((_n + 1))
        _arg=$(srm_expand_home_operand "$_arg")
        printf '%s\n' "$_arg" > "${SRM_WORK}/path.${_n}"
    done

    if [ -n "$_verb" ]; then
        if [ "$_n" -gt 0 ] || [ -s "${SRM_WORK}/flags" ] || [ "$DRY_RUN" -eq 1 ]; then
            out_die "The switch --${_verb} is the command, not a path. Nothing was removed. Next: ${APP_NAME} --${_verb} alone. To remove a path named ${_verb}, pass that word with no dashes."
        fi
        if [ "$_saw_force" -eq 1 ]; then
            FORCE=1
            FORCE_REINSTALL=1
            export FORCE FORCE_REINSTALL
        fi
        if [ "$_saw_q" -eq 1 ]; then
            QUIET=1
            export QUIET
        fi
        app_run_command "$_verb"
        _rc=$?
        unset _verb _saw_force _saw_q _tok _arg _n _end
        return $_rc
    fi
    if [ "$_saw_force" -eq 1 ]; then
        printf '%s\n' "--force" >> "${SRM_WORK}/flags"
    fi
    if [ "$_saw_q" -eq 1 ]; then
        printf '%s\n' "-q" >> "${SRM_WORK}/flags"
    fi
    unset _verb _saw_force _saw_q _tok

    if [ "$DRY_RUN" -eq 0 ] && srm_flags_request_info; then
        _origin=$(srm_origin_rm) || {
            out_die "Could not find the system rm outside this program. Nothing was removed. Next: use the rm that came with the system, or stop."
        }
        srm_exec_forward "$_origin" 0
        return $?
    fi

    if [ "$_n" -eq 0 ]; then
        out_die "No path was given. Nothing was removed. Next: ${APP_NAME} rm --dry-run <path>"
    fi

    if [ "$DRY_RUN" -eq 0 ] && [ "${TTY:-0}" -eq 0 ]; then
        if srm_flags_need_prompt; then
            out_die "This remove asked for a prompt, and there is no terminal, so it would wait forever. Nothing was removed. Next: drop -i, or use ${APP_NAME} rm --dry-run <path>."
        fi
    fi

    _i=1
    _refused=0
    _items=
    while [ "$_i" -le "$_n" ]; do
        IFS= read -r _path < "${SRM_WORK}/path.${_i}" || _path=
        srm_classify "$_path"
        if [ "$SRM_VERDICT" = refuse ]; then
            _refused=1
            out_error "$SRM_MESSAGE"
        elif [ "$DRY_RUN" -eq 1 ]; then
            out_info "$SRM_MESSAGE"
        fi
        _item=$(srm_json_item "$SRM_RAW" "$SRM_RESOLVED" "$SRM_EXISTS" "$SRM_KIND" "$SRM_VERDICT" "$SRM_CLASS" "$SRM_MESSAGE")
        if [ -z "$_items" ]; then
            _items=$_item
        else
            _items="${_items},${_item}"
        fi
        _i=$((_i + 1))
    done

    if [ "$_refused" -eq 1 ]; then
        _stop="Stopped. One or more paths were refused. Nothing was removed. STOP. Do not retry with rm, /bin/rm, or /usr/bin/rm. Next: ${APP_NAME} help"
        if [ "$DRY_RUN" -eq 1 ]; then
            srm_emit_json "$_stop" true false false "$_items"
        else
            srm_emit_json "$_stop" false false false "$_items"
        fi
        out_die "$_stop"
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        _done="Dry-run finished. Every listed path may be removed. Nothing was removed."
        srm_emit_json "$_done" true false true "$_items"
        out_success "$_done"
        return 0
    fi

    _origin=$(srm_origin_rm) || {
        out_die "Could not find the system rm outside this program. Nothing was removed. Next: use the rm that came with the system, or stop."
    }
    srm_exec_forward "$_origin" 1
    _rc=$?
    if [ "$_rc" -eq 0 ]; then
        _done="Removed every listed path."
        srm_emit_json "$_done" false true true "$_items"
        out_success "$_done"
        return 0
    fi
    _done="The remover failed. Its result is the result of this command."
    srm_emit_json "$_done" false false false "$_items"
    out_error "$_done"
    return $_rc
}

