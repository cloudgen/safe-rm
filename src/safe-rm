# =============================================================================
# app_default_collect_dirs() - Subfolders of the current path
# =============================================================================
#
# GENERAL PURPOSE:
# Fill APP_DEFAULT_DIR_LIST with one absolute subfolder per line, in byte
# order. Skip dotfolders, files, and names that contain a newline. The
# custom-path row is the next number after that list.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-27
# =============================================================================
app_default_collect_dirs() {
    APP_DEFAULT_DIR_HERE=${PWD:-}
    if [ -z "${APP_DEFAULT_DIR_HERE}" ]; then
        APP_DEFAULT_DIR_HERE=$(pwd) || APP_DEFAULT_DIR_HERE="."
    fi
    APP_DEFAULT_DIR_LIST=""
    APP_DEFAULT_DIR_COUNT=0
    APP_DEFAULT_CUSTOM_N=1
    APP_DEFAULT_DIR_PICK=""
    _ad_raw=""
    for _ad_ent in ./*; do
        [ -d "${_ad_ent}" ] || continue
        _ad_base=${_ad_ent#./}
        case "${_ad_base}" in
            ''|.*)
                continue
                ;;
        esac
        case "${_ad_base}" in
            *'
'*)
                continue
                ;;
        esac
        case "${APP_DEFAULT_DIR_HERE}" in
            /)
                _ad_full="/${_ad_base}"
                ;;
            *)
                _ad_full="${APP_DEFAULT_DIR_HERE}/${_ad_base}"
                ;;
        esac
        if [ -z "${_ad_raw}" ]; then
            _ad_raw=${_ad_full}
        else
            _ad_raw="${_ad_raw}
${_ad_full}"
        fi
    done
    if [ -n "${_ad_raw}" ]; then
        _ad_sorted=$(printf '%s\n' "${_ad_raw}" | LC_ALL=C sort) || _ad_sorted=${_ad_raw}
        APP_DEFAULT_DIR_LIST=${_ad_sorted}
        unset _ad_sorted
    fi
    unset _ad_raw _ad_ent _ad_base _ad_full
    app_default_walk_dirs count "" || true
    APP_DEFAULT_CUSTOM_N=$((APP_DEFAULT_DIR_COUNT + 1))
}

# =============================================================================
# app_default_walk_dirs() - Print or resolve one subfolder row
# =============================================================================
#
# Mode print draws 1…N. Mode count sets APP_DEFAULT_DIR_COUNT. Mode index
# and mode name set APP_DEFAULT_DIR_PICK to the absolute folder and return 0
# on a hit. The list stays in this shell. Do not pipe this function.
# =============================================================================
app_default_walk_dirs() {
    _ad_mode=${1-}
    _ad_want=${2-}
    _ad_i=0
    _ad_rest=${APP_DEFAULT_DIR_LIST-}
    APP_DEFAULT_DIR_PICK=""
    while [ -n "${_ad_rest}" ]; do
        _ad_full=${_ad_rest%%
*}
        case "${_ad_rest}" in
            *'
'*)
                _ad_rest=${_ad_rest#*
}
                ;;
            *)
                _ad_rest=""
                ;;
        esac
        [ -n "${_ad_full}" ] || continue
        _ad_i=$((_ad_i + 1))
        _ad_base=${_ad_full##*/}
        case "${_ad_mode}" in
            print)
                out_menu_choice "${_ad_i}" "${_ad_base}" "${_ad_full}"
                ;;
            index)
                if [ "${_ad_i}" = "${_ad_want}" ]; then
                    APP_DEFAULT_DIR_PICK=${_ad_full}
                    unset _ad_mode _ad_want _ad_i _ad_rest _ad_full _ad_base
                    return 0
                fi
                ;;
            name)
                if [ "${_ad_base}" = "${_ad_want}" ]; then
                    APP_DEFAULT_DIR_PICK=${_ad_full}
                    unset _ad_mode _ad_want _ad_i _ad_rest _ad_full _ad_base
                    return 0
                fi
                ;;
        esac
    done
    if [ "${_ad_mode}" = "count" ]; then
        APP_DEFAULT_DIR_COUNT=${_ad_i}
    fi
    case "${_ad_mode}" in
        index|name)
            unset _ad_mode _ad_want _ad_i _ad_rest _ad_full _ad_base
            return 1
            ;;
    esac
    unset _ad_mode _ad_want _ad_i _ad_rest _ad_full _ad_base
    return 0
}

